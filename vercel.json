{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/news-sitemap.xml",
      "destination": "/api/index.py"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index.py"
    },
    {
      "source": "/feed.xml",
      "destination": "/api/index.py"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index.py"
    },
    {
      "source": "/i/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/news/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
