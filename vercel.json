{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/i/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/news/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/go/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/directory",
      "destination": "/api/index.py"
    },
    {
      "source": "/sitemap.html",
      "destination": "/api/index.py"
    },
    {
      "source": "/atom.xml",
      "destination": "/api/index.py"
    },
    {
      "source": "/target-sitemap.xml",
      "destination": "/api/index.py"
    },
    {
      "source": "/news-sitemap.xml",
      "destination": "/api/index.py"
    }
  ]
}
